# 数据库配置
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/fufanmanus

# Redis 配置
REDIS_HOST=localhost  
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30


LOGGING_LEVEL=WARNING  # 日志级别改为 WARNING，只显示警告和错误信息。
ENV_MODE=local
OPENAI_API_KEY=sk-your-api-key
MODEL_TO_USE=deepseek/deepseek-v4-flash


DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com


# Langfuse 配置
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-api-key
LANGFUSE_HOST=https://us.cloud.langfuse.com


# PPIP/E2B 沙箱服务配置
E2B_API_KEY=sk-your-e2b-api-key
SANDBOX_TEMPLATE_ID=txi15v1zt1gcyqb


TAVILY_API_KEY=tvly-your-tavily-api-key
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# Optional: GitHub token for higher read-only public repository API limits.
# Leave empty to use unauthenticated GitHub API requests.
GITHUB_TOKEN=<your-read-only-github-token>

# Optional semantic long-term memory. Keep disabled unless the database supports
# pgvector and the selected embedding provider credentials are configured.
VECTOR_MEMORY_ENABLED=false
VECTOR_MEMORY_EMBEDDING_MODEL=openai/text-embedding-v4
VECTOR_MEMORY_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
VECTOR_MEMORY_MATCH_THRESHOLD=0.65
VECTOR_MEMORY_MATCH_COUNT=3
VECTOR_MEMORY_EMBEDDING_TIMEOUT_SECONDS=15


